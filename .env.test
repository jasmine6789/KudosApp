# Environment variables for the frontend test suite only (Vitest runs in
# "test" mode and loads this file automatically: see vite.config.ts).
# These are not real credentials: no test ever makes a real network call
# (src/lib/api.ts is always mocked), so these only need to satisfy env.ts's
# shape validation, not point at a real, reachable Supabase project. This
# file exists so `npm run test` works the same on a fresh clone and in CI
# as it does with a developer's own .env.local.

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_SUPABASE_FUNCTIONS_URL=http://localhost:54321/functions/v1
